{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.ts", "**/*.tsx", "App.tsx", "index.js"],
  // Edge funkce běží na Denu (`Deno.serve`, `jsr:` importy), ne v Reactu
  // Native. Do téhle kontroly nepatří — typy Dena tu nejsou a nikdy nebudou.
  "exclude": ["node_modules", "supabase/functions"]
}
