<?xml version="1.0" encoding="utf-8"?>
<!-- STUB. „Hard Split": inkoust/kost, nulový poloměr, Archivo Black by
     šlo doplnit přes assetový font; zatím systémový bold. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/splittingly_widget_bg"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOU ARE OWED"
        android:textColor="#5A5A5A"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/widget_owed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#101010"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_owe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="#FF2D16"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
