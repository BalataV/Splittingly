{
  "expo": {
    "name": "Splittingly",
    "slug": "splittingly",
    "scheme": "splittingly",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFE500",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.balata.splittingly",
      "appleTeamId": "5N974388GT",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:splittingly.com"
      ],
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.balata.splittingly"
        ]
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.balata.splittingly",
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "splittingly.com",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFE500",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "supabaseUrl": "https://aqikqephinmelmrbsage.supabase.co",
      "supabaseAnonKey": "sb_publishable_jcFrlwXXrQjryxjT4fUFUA_NRheYFST",
      "admobAndroidAppId": "ca-app-pub-6648059854325708~3909236635",
      "admobIosAppId": "ca-app-pub-6648059854325708~5171502368",
      "admobBannerAndroid": "ca-app-pub-6648059854325708/7050405295",
      "admobBannerIos": "ca-app-pub-6648059854325708/8999262852",
      "admobRectangleAndroid": "ca-app-pub-6648059854325708/5298184395",
      "admobRectangleIos": "ca-app-pub-6648059854325708/7111466116",
      "eas": {
        "projectId": "5815c77b-07f5-4745-840d-6eaac97db942"
      }
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-screen-orientation",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFE500",
          "dark": {
            "backgroundColor": "#101010"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Splittingly needs access to your photos so you can attach a receipt to an expense.",
          "cameraPermission": "Splittingly needs access to your camera so you can photograph a receipt.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#FFE500"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6648059854325708~3909236635",
          "iosAppId": "ca-app-pub-6648059854325708~5171502368"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Splittingly uses this to show you more relevant ads. You can still use every feature of the app if you say no."
        }
      ],
      "./plugins/withAndroidWidget",
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "5N974388GT"
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Mint",
            "ios": "./assets/alt-icons/mint.png",
            "android": {
              "foregroundImage": "./assets/alt-icons/mint-foreground.png",
              "backgroundColor": "#00E5C0"
            }
          },
          {
            "name": "Neon",
            "ios": "./assets/alt-icons/neon.png",
            "android": {
              "foregroundImage": "./assets/alt-icons/neon-foreground.png",
              "backgroundColor": "#2B0A5E"
            }
          },
          {
            "name": "Dusk",
            "ios": "./assets/alt-icons/dusk.png",
            "android": {
              "foregroundImage": "./assets/alt-icons/dusk-foreground.png",
              "backgroundColor": "#4A2E8A"
            }
          }
        ]
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5815c77b-07f5-4745-840d-6eaac97db942"
    },
    "owner": "balatav"
  }
}
